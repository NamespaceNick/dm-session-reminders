{
  "name": "dm-session-reminders",
  "version": "0.2.0",
  "description": "Pop up reminders while you run a game session: on timers, or on creature turns and combat rounds with Initiative Tracker.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "builtin-modules": "^5.5.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "tslib": "^2.8.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  }
}
